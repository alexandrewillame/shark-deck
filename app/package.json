{
  "name": "sharkdeck",
  "version": "0.1.0",
  "description": "Open-source configurator for Attack Shark keyboards and mice",
  "author": "SharkDeck contributors",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/alexandrewillame/shark-deck",
  "main": "out/main/index.js",
  "desktopName": "sharkdeck.desktop",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "node scripts/kill-running-app.mjs && electron-vite build && electron-builder --dir && node scripts/organize-dist.mjs",
    "dist": "node scripts/kill-running-app.mjs && electron-vite build && electron-builder && node scripts/organize-dist.mjs",
    "dist:portable": "node scripts/kill-running-app.mjs && electron-vite build && electron-builder --win portable && node scripts/organize-dist.mjs",
    "dist:mac": "node scripts/kill-running-app.mjs && electron-vite build && electron-builder --mac && node scripts/organize-dist.mjs",
    "dist:linux": "node scripts/kill-running-app.mjs && electron-vite build && electron-builder --linux && node scripts/organize-dist.mjs",
    "prep:wincodesign": "node scripts/prep-wincodesign.mjs",
    "prep:kill": "node scripts/kill-running-app.mjs",
    "rebuild": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "map": "node scripts/gen-map.mjs",
    "map:check": "node scripts/gen-map.mjs --check",
    "i18n:add": "node scripts/i18n.mjs add",
    "i18n:todo": "node scripts/i18n.mjs todo",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:ui": "vitest run --project ui --passWithNoTests",
    "test:changed": "vitest run --changed",
    "test:bail": "vitest run --bail=1",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=default --silent=false",
    "check": "npm run --silent test:contract && npm run --silent test:unit && npm run --silent typecheck && npm run --silent test:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "node scripts/extract-vendor-protocol.mjs",
    "extract:kb": "node scripts/extract-keyboard-protocol.mjs",
    "dump:kb": "node scripts/dump-keyboard-state.mjs",
    "dump:mouse": "node scripts/dump-mouse-state.mjs",
    "extract:qmk": "node scripts/extract-qmktop-protocol.mjs",
    "identify:kb": "node scripts/identify-keyboard.mjs",
    "verify:he": "vite-node --config vitest.config.ts scripts/verify-he-driver.ts",
    "snapshot:kb": "vite-node --config vitest.config.ts scripts/kb-snapshot.ts",
    "verify:writes": "vite-node --config vitest.config.ts scripts/verify-he-writes.ts",
    "probe:profiles": "vite-node --config vitest.config.ts scripts/probe-profile-scope.ts",
    "probe:effects": "vite-node --config vitest.config.ts scripts/probe-light-effects.ts"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "node-hid@3.4.0": true
  }
}
