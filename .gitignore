# Dependencies / build environment
node_modules/

# electron-vite intermediate output
app/out/

# electron-builder raw staging dir
app/release/

# Sorted build output (regenerated by `npm run dist`)
/dist/

# Logs / OS cruft
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Local zip backups and scratch image staging — moved out of the tree, but
# ignored so they never come back in. See ../sharkdeck-assets/.
Backup/
images-temp/
Screenshots/
legacy/
logo-temp/

Notes-shark-redo.txt
tooltip-animations-preview.html

# Local press kit: full-size screenshots, videos and GIFs for posts. What the
# README shows lives in docs/media/.
/press-kit/

# Claude Code: settings.json and skills/ are shared project files and stay
# tracked; settings.local.json is each person's own.
.claude/settings.local.json

# app/scripts/_raw/ is ignored by app/.gitignore: extracted vendor data, the
# sharkfin download and the art cache. The tests that read it skip when it is
# absent. It is also excluded from *search* via the root .ignore file.
