# Search-only exclusions (ripgrep / agent tooling). NOT a .gitignore — every
# path below stays tracked. The point is that a grep for a real symbol should
# return real source, not ~70k lines of machine-generated data.
#
# Build output (app/out, app/release, dist, node_modules, Backup, images-temp)
# needs no entry here: it is in .gitignore, which ripgrep already honours now
# that this is a git repo.
#
# To search one of these anyway, pass the path explicitly or use rg --no-ignore.

# Auto-extracted vendor protocol dumps. 48k lines, incl. a 2.6 MB single-line
# qmk-bundle.js. Regenerate with `npm run extract*`. Tracked because three
# tests read them as fixtures — see the note in .gitignore.
app/scripts/_raw/

# Frida capture sessions and analysis dumps: ~22.5k lines of raw evidence.
# The prose that interprets them (README.md, FINDINGS*.md, CAPTURE-*.md) and
# the capture tooling (*.py, *.js) stay searchable.
docs/reverse-engineering/*.jsonl
docs/reverse-engineering/*.json
docs/reverse-engineering/*.txt
docs/reverse-engineering/*.bin

# Superseded Python V8 switcher. Reference only; the native auto-switch
# feature was generalised from it and lives in app/src/main/profiles/.
legacy/

# Generated by scripts/generate-tooltip-preview.mjs.
tooltip-animations-preview.html

# 6.8k lines of dependency tree.
app/package-lock.json
